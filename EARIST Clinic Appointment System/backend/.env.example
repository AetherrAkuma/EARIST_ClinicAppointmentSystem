# =================================================================
# EARIST Clinic Appointment System — Environment Configuration
# =================================================================

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=earist_clinic_super_secure_jwt_secret_2026

# =================================================================
# SMTP Email Dispatch Configuration (Optional)
# If left unset, the system safely logs email notifications in the console
# without blocking or failing appointment confirmations.
# =================================================================

# For Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-clinic-email@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="EARIST Manila Campus Clinic" <your-clinic-email@gmail.com>

# For Institutional / Custom Mail Server:
# SMTP_HOST=mail.earist.edu.ph
# SMTP_PORT=587
# SMTP_USER=clinic@earist.edu.ph
# SMTP_PASS=your_email_password
# SMTP_FROM="EARIST Campus Health Services" <clinic@earist.edu.ph>

