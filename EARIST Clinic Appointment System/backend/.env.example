# =================================================================
# EARIST Clinic Appointment System — Environment Configuration
# =================================================================

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=earist_clinic_super_secure_jwt_secret_2026

# =================================================================
# Brevo (Sendinblue) Email Dispatch Configuration
# =================================================================
# Option 1: Brevo REST API Key (Simplest & Best — No SMTP setup needed)
# Simply paste your Brevo API key below:
# =================================================================
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@e-clinic.ragetech.dev
BREVO_SENDER_NAME="EARIST e-Clinic"

# =================================================================
# Cloudflare Turnstile Anti-Bot Protection
# =================================================================
# Secret key obtained from Cloudflare Dashboard > Turnstile
# For local testing, use Cloudflare's always-pass secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=e-clinic.ragetech.dev,localhost,127.0.0.1

# =================================================================
# Option 2: Brevo SMTP Relay (Alternative)
# =================================================================
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email@example.com
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM="EARIST e-Clinic" <no-reply@e-clinic.ragetech.dev>

